{
  // 一键任务菜单：快捷键 Cmd+Shift+B 打开「运行生成任务」，
  // 或按 Cmd+Shift+P → 输入「运行任务」→ 回车，看到完整清单。
  // 这里只保留本地开发任务；部署与服务器操作不随开源版本发布。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "① 启动网站（本地调试）",
      "detail": "npm start —— 访问 http://localhost:3000",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": "^$", "file": 1, "location": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "服务器已启动|listening|Server running"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "② 开发模式（改代码自动重启）",
      "detail": "npm run dev —— 保存 server.js 后自动重载，前端改动刷新浏览器即可",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": "^$", "file": 1, "location": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "服务器已启动|listening|Server running|Restarting"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "③ 在浏览器中打开网站",
      "detail": "打开 http://localhost:3000（需服务已启动）",
      "type": "shell",
      "command": "open",
      "args": ["http://localhost:3000"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "never", "panel": "shared" }
    },
    {
      "label": "④ 停止本地服务",
      "detail": "结束占用 3000 端口的 node 进程",
      "type": "shell",
      "command": "lsof -ti:3000 | xargs kill 2>/dev/null; echo '✅ 本地服务已停止'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "⑤ 重置本地测试数据（60 例模拟患者）",
      "detail": "清空本地数据库，未找到演示文件时自动用 scripts/generate-test-cohort.py 生成 60 例；只影响本机",
      "type": "shell",
      "command": "bash ./scripts/reset-local-data.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
