# =========================================================
# 前列腺癌随访与科研数据库 · 环境变量示例
# 用法：cp .env.example .env 然后按需修改（.env 已被 .gitignore 排除）
# =========================================================

# ---------- 服务 ----------
PORT=3000
# 只监听本机；部署到服务器需要反代时改为 0.0.0.0
HOST=127.0.0.1
APP_TZ=Asia/Shanghai

# ---------- 鉴权（必填）----------
# 生成方式：openssl rand -hex 32
# 少于 32 位或使用示例值，服务会拒绝启动
JWT_SECRET=
JWT_EXPIRES=8h

# 仅在数据库为空、首次启动时创建管理员账号；之后可留空
# 要求：用户名不得为 admin，密码至少 12 位
INIT_ADMIN_USER=
INIT_ADMIN_PASS=

# ---------- 存储路径（可选，默认在项目内）----------
# DATA_DIR=./data
# DB_FILE=./data/clinical.db
# UPLOAD_DIR=./uploads

# ---------- AI 病历登记（可选）----------
# 不配置 DASHSCOPE_API_KEY 时自动进入「离线演练模式」，
# 返回结构合法但不联网的示例结果，便于本地验证链路。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL_EXTRACT=qwen3-vl-flash
AI_MODEL_REDACT=qwen-turbo
AI_INTAKE_ENABLED=true
# AI_MAX_TOKENS=16000
# AI_MAX_CONCURRENT=2
# AI_CALL_TIMEOUT_MS=120000
